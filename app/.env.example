# Copy to .env.local and fill in. NEVER commit real secrets — .env* is gitignored.
# Rotate any key that has ever been shared, pasted, or committed.

# --- Core ---
MONGODB_URI=mongodb://127.0.0.1:27017/cloud_architecture_studio
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Password hashing cost (10–15). Higher = slower + stronger. Default 12.
BCRYPT_ROUNDS=12

# Seed super admin (used by: npm run seed) — set a strong, unique password.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=

# --- Secrets at rest (Constitution III) ---
# 32-byte key, base64. Required in production; dev derives one from AUTH_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Rate limiting (security checklist #1; all optional — safe defaults apply) ---
# RATE_LIMIT_ENABLED=true            # set false to disable (e.g. in tests)
# RL_AUTH_FREE_ATTEMPTS=5            # failed sign-ins before backoff engages
# RL_AUTH_BACKOFF_BASE_MS=1000       # first backoff delay (doubles each failure)
# RL_AUTH_BACKOFF_MAX_MS=900000      # cap on backoff delay (15 min)
# RL_AUTH_ATTEMPT_TTL_MS=3600000     # failure-record lifetime (1 h)
# RL_EMAIL_MAX=5                     # verification/reset emails per window
# RL_EMAIL_WINDOW_MS=3600000         # email window (1 h)
# RL_REGISTER_MAX=10                 # sign-ups per IP per window
# RL_REGISTER_WINDOW_MS=3600000      # register window (1 h)
# RL_LLM_MAX=20                      # generation turns per user per window
# RL_LLM_WINDOW_MS=60000             # LLM window (1 min)

# --- LLM provider (configurable; in-app Settings → AI Provider overrides these) ---
# anthropic | groq | nvidia | gemini | openrouter | huggingface | bedrock
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Hard per-call ceiling (ms) so a slow/rate-limited provider can't hang a turn
# forever — the call aborts and the turn degrades or errors clearly. Default 90000.
# Lower it to fail faster on a flaky provider; raise it for a slow-but-reliable one.
# LLM_TIMEOUT_MS=90000
# Fill ONLY the provider you use. Paid providers (e.g. Anthropic) must be
# rotated if exposed and kept behind the rate limits above.
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# HF_TOKEN=
ANTHROPIC_API_KEY=
# AWS Bedrock: a Bedrock API key (bearer token), NOT an AWS access key pair.
# Generate in the Bedrock console → API keys (short-term keys last up to 12 h,
# which suits sandbox accounts; long-term keys need an IAM user). The AWS-
# standard name AWS_BEARER_TOKEN_BEDROCK is honoured as an alias.
AWS_BEDROCK_API_KEY=
# Region serving the Bedrock models (falls back to AWS_REGION, then us-east-1).
# AWS_BEDROCK_REGION=us-east-1

# --- Official provider MCP servers (leave empty to run in indicative mode) ---
AWS_MCP_COMMAND=
AWS_MCP_TOOL=aws___search_documentation
AWS_COST_MCP_COMMAND=
MONGODB_MCP_COMMAND=
MONGODB_MCP_TOOL=search-knowledge

# --- AWS (SSO connection + Price List API fallback) ---
AWS_SSO_START_URL=
AWS_SSO_REGION=us-east-1
AWS_REGION=us-east-1

# --- MongoDB Atlas (service-account connection, scoped read) ---
ATLAS_API_BASE=https://cloud.mongodb.com

# --- Email delivery (verification gate + password reset) ---
# resend | dev  — dev logs the link and surfaces it in non-production responses.
EMAIL_PROVIDER=dev
EMAIL_FROM=Cloud Architecture Studio <noreply@example.com>
RESEND_API_KEY=

# Absolute base URL used in emailed links.
APP_BASE_URL=http://localhost:3000

# --- Feature 008: knowledge store & web research (all optional) ---
# Knowledge store: seeded best-practice rules + self-distilled lessons injected
# into the planner and reviewer. Disable to fall back to hardcoded patterns only.
KNOWLEDGE_STORE_ENABLED=true
# How many knowledge entries may be injected per turn (default 6).
KNOWLEDGE_TOP_K=6

# Web research fills gaps neither the knowledge store nor the provider MCPs can
# answer, restricted to official documentation domains. Leave every key blank to
# disable the rung entirely — generation degrades gracefully (FR-027).
WEB_RESEARCH_ENABLED=false
# Backend order is Tavily -> Brave -> disabled, chosen by which key is present.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Official AWS documentation MCP — fallback knowledge rung after the AWS
# Knowledge MCP. Example: uvx awslabs.aws-documentation-mcp-server@latest
AWS_DOCS_MCP_COMMAND=

# Optional advisory topology cross-check. Its opinion informs self-review only
# and is never authoritative nor shown to the user as truth (FR-040).
DIAGRAM_MCP_CROSSCHECK_ENABLED=false

# --- Feature 008: per-role model tiering (US2) ---
# NOT AN ENV VAR — configured in Settings -> AI Provider ("Match the model to
# the task") and stored in the database, like the provider, model and API keys
# it governs. It applies workspace-wide with no restart, and per-step model
# assignment is set on the same screen.
#
# OFF BY DEFAULT ON PURPOSE. Enabling it changes which model serves each step,
# so record the pre-tiering design-quality baseline FIRST — once it is on, those
# "before" numbers can never be reproduced and SC-004 becomes unverifiable:
#   1. node scripts/measure-baseline.mjs   (writes specs/008-.../baseline.json)
#   2. enable tiering in Settings -> AI Provider
#   3. re-measure and compare
